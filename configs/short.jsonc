{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo":{
    "type": "none",
  },
  "display": {
    "size": {
      "binaryPrefix": "si",
      "ndigits": 1
    },
    "separator": "   ",
    "color": {
      "keys": "red",
      "title": "red"
    }
  },
  "modules": [

/*      HINTS!!11!!!!!
   Each block is 41 characters long ("How is 'Hardware' and 'Software' centered then?" Shush!)
   The sides have 3 space padding
   The separator is 3 spaces
   Also not forry for the syntax not being consistand, this file was written over 5 configs and a month
*/
    {
      "type": "custom",
      "format": "{#1;white}   _____ _   {#}{#1;red}_{#}{#1;white}     _   _____       _   {#}"
    },
    {
      "type": "custom",
      "format": "{#1}  |_   _| |_{#}{#1;red}|_|{#}{#1}___| |_|  _  |___ _| |  {#}"
    },
    {
      "type": "custom",
      "format": "{#1}    | | |   | |   | '_|   __| .'| . |  {#}"
    },
    {
      "type": "custom",
      "format": "{#1}    |_| |_|_|_|_|_|_,_|__|  |__,|___|  {#}"
    },
    {
      "type": "custom",
      "format": " ",
    },
    {
      "type": "custom",
      "format": "───────────────────────────────────────",
    },
    {
      "type": "custom",
      "format": "|                                     |",
    },
    {
      "type": "host",
      "key": "{#white}|{#}   {#1;red}MODEL{#}    ",
      "format": "T14 Gen1              |",
    },
    {
      "type": "os",
      "key": "{#white}|{#}   {#1;red}OS{#}       ",
      "format": "{name} {version-id}           |"
    },
    {
      "type": "uptime",
      "key": "{#white}|{#}   {#1;red}UPTIME{#}   ",
      "format": "{days} Days & {hours>2} Hours     |",
    },
    {
      "type": "kernel",
      "format": "{release<19}   |",
      "key": "{#white}|{#}   {#1;red}KERNEL{#}   "
    },
    {
      "type": "packages",
      "key": "{#white}|{#}   {#1;red}PKGS{#}     ",
      "format": "{all<19}   |"
    },
    {
      "type": "custom",
      "format": "|                                     |",
    },
    {
      "type": "custom",
      "format": "───────────────────────────────────────",
    },
  ]
}
